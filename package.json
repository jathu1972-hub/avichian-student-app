{
  "name": "avichian-student-app",
  "version": "0.1.0",
  "private": true,
  "description": "AVICHIAN Student App — private campus platform for Avichi Arts and Science College",
  "type": "module",
  "workspaces": [
    "shared"
  ],
  "scripts": {
    "predev": "npm run build -w @avichian/shared",
    "dev": "vite --port 5173",
    "prebuild": "npm run build -w @avichian/shared",
    "build": "vite build",
    "build:check": "npm run build -w @avichian/shared && tsc --noEmit && vite build",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 5173",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios"
  },
  "dependencies": {
    "@avichian/shared": "*",
    "appwrite": "^26.1.0",
    "framer-motion": "^12.16.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
